# Copy to .env.local for local work; set the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values.

# Neon (or any PostgreSQL) connection string. Server-side only.
# On Vercel, set DIFFERENT values for Preview (a separate test database) and Production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# The only database host this deployment may connect to (the HOST part of DATABASE_URL, e.g. ep-xxx-pooler.region.aws.neon.tech).
# Required on Vercel (the app refuses to connect without it); optional locally. Set it separately for Preview and Production.
EXPECTED_DATABASE_HOST=

# Random secret (>= 32 chars) used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT secret for Preview and Production (a session is also bound to its deployment, VERCEL_ENV).
AUTH_SECRET=

# First administrator, used only by `npm run create-admin` (not read by the web app).
ADMIN_EMAIL=
ADMIN_PASSWORD=
