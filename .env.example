# Copy to .env.local for local work; set the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values.

# Neon (or any PostgreSQL) connection string. Server-side only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random secret (>= 32 chars) used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First administrator, used only by `npm run create-admin` (not read by the web app).
ADMIN_EMAIL=
ADMIN_PASSWORD=
